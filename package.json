{
  "name": "pi-run-fold",
  "version": "0.1.0",
  "private": true,
  "description": "Fold each agent run in Pi's TUI into one summary line, keeping the prompt and the final answer",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=process tests/run-fold.test.ts",
    "check": "bun run lint && bun run test",
    "build": "bun build index.ts --outfile dist/index.min.js --target node --format esm --minify --sourcemap=linked --external '@earendil-works/*'"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
